                            "schema": {
                                "$ref": "#/components/schemas/Criteria"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "The product's questions",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "total": {
                                            "type": "integer"
                                        },
                                        "elements": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "id": {
                                                        "type": "string"
                                                    },
                                                    "productId": {
                                                        "type": "string"
                                                    },
                                                    "question": {
                                                        "type": "string"
                                                    },
                                                    "answer": {
                                                        "type": "string"
