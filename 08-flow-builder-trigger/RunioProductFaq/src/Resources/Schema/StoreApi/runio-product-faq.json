{
    "openapi": "3.0.0",
    "info": [],
    "paths": {
        "/runio/product/{productId}/faq": {
            "get": {
                "tags": [
                    "Product",
                    "Endpoints supporting Criteria "
                ],
                "summary": "Fetch the questions and answers of a product",
                "description": "Returns the active questions of a product, sorted by position. Variants return the questions of their parent product. Products that are not visible in the sales channel return 404.",
                "operationId": "readRunioProductFaqGet",
                "parameters": [
                    {
                        "name": "productId",
                        "in": "path",
                        "description": "Product ID",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{32}$"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "The product's questions",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "total": {
                                            "type": "integer"
                                        },
                                        "elements": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "id": {
                                                        "type": "string"
                                                    },
                                                    "productId": {
                                                        "type": "string"
                                                    },
                                                    "question": {
                                                        "type": "string"
                                                    },
                                                    "answer": {
                                                        "type": "string"
                                                    },
                                                    "position": {
                                                        "type": "integer"
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "404": {
                        "$ref": "#/components/responses/404"
                    }
                },
                "security": [
                    {
                        "ApiKey": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Product",
                    "Endpoints supporting Criteria "
                ],
                "summary": "Fetch the questions and answers of a product",
                "description": "Returns the active questions of a product, sorted by position. Variants return the questions of their parent product. Products that are not visible in the sales channel return 404.",
